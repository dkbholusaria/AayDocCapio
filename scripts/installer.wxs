<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="AayDocCapio 1.4.1"
    Version="1.4.1"
    Manufacturer="Deepak Bhholusaria"
    UpgradeCode="FDE0FF07-C5AF-4909-BCD4-150EB9E14AA2"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of AayDocCapio is already installed." />

    <!-- ── Detect existing .exe (Inno) install ───────────────────── -->
    <Property Id="INNOINSTALL">
      <RegistrySearch
        Id="SearchInnoInstallerMarker"
        Root="HKLM"
        Key="Software\AayDocCapio"
        Name="InstallerType"
        Type="raw" />
    </Property>

    <!-- Block MSI install when .exe version is detected.
         User must uninstall the .exe version first from Windows Settings. -->
    <Launch
      Condition="Installed OR INNOINSTALL &lt;&gt; &quot;Inno&quot;"
      Message="AayDocCapio is already installed using the .exe setup.&#13;&#10;&#13;&#10;Please uninstall the .exe version from Windows Settings (Apps &amp; Features) first, then run the MSI installer again." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)license.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)..\resources\installer_wix_dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)..\resources\installer_wix_banner.bmp" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- ── Install directory ───────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AayDocCapio" />
    </StandardDirectory>

    <!-- ── App data directory ─────────────────────────────────── -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="APPDATAFOLDER" Name="AayDocCapio" />
    </StandardDirectory>

    <!-- ── Start Menu ─────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AayDocCapio" />
    </StandardDirectory>

    <!-- ── Features ───────────────────────────────────────────── -->
    <Feature Id="MainApplication" Title="AayDocCapio" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppDataFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Package>

  <!-- ── App files (entire dist\AayDocCapio\ folder) ─────────── -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(sys.SOURCEFILEDIR)..\dist\AayDocCapio\**">
        <Exclude Files="$(sys.SOURCEFILEDIR)..\dist\AayDocCapio\AayDocCapio.exe" />
      </Files>
      <Component Id="MainExecutable" Guid="60C6D0C6-C056-4FB5-9834-42E2F5B2B09C">
        <File Id="MainExe" Source="$(sys.SOURCEFILEDIR)..\dist\AayDocCapio\AayDocCapio.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ── Seed assessment_years.json to AppData ────────────────── -->
  <!-- tax_vault.json is created by the app at runtime in this folder.
       It is intentionally not installed by MSI, so uninstall/migration leaves it untouched. -->
  <Fragment>
    <ComponentGroup Id="AppDataFiles" Directory="APPDATAFOLDER">
      <Component
        Id="AssessmentYears"
        Guid="C5D4E3F2-1A2B-3C4D-5E6F-7A8B9C0D1E2F"
        NeverOverwrite="yes"
        Permanent="yes">
        <File Source="$(sys.SOURCEFILEDIR)..\assessment_years.json" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ── Start Menu shortcut ───────────────────────────────────── -->
  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="87A38D23-1A20-437F-A179-415CBAFE4F92">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="AayDocCapio"
          Target="[#MainExe]"
          WorkingDirectory="INSTALLFOLDER" />
        <Shortcut
          Id="UninstallShortcut"
          Name="Uninstall AayDocCapio"
          Target="[SystemFolder]msiexec.exe"
          Arguments="/x [ProductCode]" />
        <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\AayDocCapio"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <RegistryValue
          Root="HKLM"
          Key="Software\AayDocCapio"
          Name="InstallerType"
          Type="string"
          Value="MSI" />
        <RegistryValue
          Root="HKLM"
          Key="Software\AayDocCapio"
          Name="ProductCode"
          Type="string"
          Value="[ProductCode]" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- ── Desktop shortcut ───────────────────────────────────────── -->
  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="A646D0C8-9C34-4D91-9776-5BE152E4BE78">
        <Shortcut
          Id="ApplicationDesktopShortcut"
          Name="AayDocCapio"
          Target="[#MainExe]"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
          Root="HKCU"
          Key="Software\AayDocCapio"
          Name="desktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

</Wix>
